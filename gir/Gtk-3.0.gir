          <parameter name="key_file" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkprintsettings.c"
                 line="1822">the #GKeyFile to retrieve the settings from</doc>
            <type name="GLib.KeyFile" c:type="GKeyFile*"/>
