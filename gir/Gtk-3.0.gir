          </instance-parameter>
          <parameter name="count" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtktextiter.c"
                 line="2661">number of lines to move forward</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
      </method>
      <method name="forward_search"
              c:identifier="gtk_text_iter_forward_search">
        <doc xml:space="preserve"
             filename="gtk/gtktextiter.c"
             line="4913">Searches forward for @str. Any match is returned by setting
@match_start to the first character of the match and @match_end to the
first character after the match. The search will not continue past
@limit. Note that a search is a linear or O(n) operation, so you
may wish to use @limit to avoid locking up your UI on large
buffers.

@match_start will never be set to a #GtkTextIter located before @iter, even if
there is a possible @match_end after or at @iter.</doc>
        <source-position filename="gtk/gtktextiter.h" line="380"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk/gtktextiter.c"
