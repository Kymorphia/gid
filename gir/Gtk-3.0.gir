          <parameter name="context" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkcellarea.c"
                 line="2074">the #GtkCellAreaContext which has already been requested for widths.</doc>
            <type name="CellAreaContext" c:type="GtkCellAreaContext*"/>
          </parameter>
          <parameter name="widget" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkcellarea.c"
                 line="2075">the #GtkWidget where @area will be rendering</doc>
            <type name="Widget" c:type="GtkWidget*"/>
          </parameter>
          <parameter name="width" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkcellarea.c"
                 line="2076">the width for which to check the height of this area</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
          <parameter name="minimum_height"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full"
                     optional="1"
                     allow-none="1">
