          <parameter name="y"
                     direction="inout"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gtk/gtktreeview.c"
                 line="16390">the y coordinate (relative to widget coordinates)</doc>
            <type name="gint" c:type="gint*"/>
          </parameter>
          <parameter name="keyboard_tip" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtktreeview.c"
                 line="16391">whether this is a keyboard tooltip or not</doc>
