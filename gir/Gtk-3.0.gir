          </instance-parameter>
          <parameter name="event" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkcellrenderer.c"
                 line="846">a #GdkEvent</doc>
            <type name="Gdk.Event" c:type="GdkEvent*"/>
