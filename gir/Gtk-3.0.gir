        </return-value>
        <parameters>
          <instance-parameter name="menu" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkmenu.c"
                 line="2288">the #GtkMenu to pop up</doc>
            <type name="Menu" c:type="GtkMenu*"/>
          </instance-parameter>
          <parameter name="widget" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkmenu.c"
                 line="2289">the #GtkWidget to align @menu with</doc>
            <type name="Widget" c:type="GtkWidget*"/>
          </parameter>
          <parameter name="widget_anchor" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkmenu.c"
                 line="2290">the point on @widget to align with @menu's anchor point</doc>
            <type name="Gdk.Gravity" c:type="GdkGravity"/>
          </parameter>
          <parameter name="menu_anchor" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkmenu.c"
                 line="2291">the point on @menu to align with @widget's anchor point</doc>
            <type name="Gdk.Gravity" c:type="GdkGravity"/>
          </parameter>
          <parameter name="trigger_event"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
