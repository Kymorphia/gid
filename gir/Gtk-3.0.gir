          </instance-parameter>
          <parameter name="path"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk/gtktreeview.c"
                 line="13726">a #GtkTreePath for the row, or %NULL to get only horizontal coordinates</doc>
            <type name="TreePath" c:type="GtkTreePath*"/>
          </parameter>
          <parameter name="column"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk/gtktreeview.c"
                 line="13727">a #GtkTreeViewColumn for the column, or %NULL to get only vertical coordinates</doc>
            <type name="TreeViewColumn" c:type="GtkTreeViewColumn*"/>
          </parameter>
          <parameter name="rect"
                     direction="out"
