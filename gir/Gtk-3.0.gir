            <doc xml:space="preserve"
                 filename="gtk/gtkmenubutton.c"
                 line="980">a #GtkMenuButton</doc>
            <type name="MenuButton" c:type="GtkMenuButton*"/>
          </instance-parameter>
          <parameter name="direction" transfer-ownership="none">
