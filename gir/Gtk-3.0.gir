          </instance-parameter>
          <parameter name="visible" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkplacessidebar.c"
                 line="5572">whether to show the valid targets or not.</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
          <parameter name="context" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkplacessidebar.c"
                 line="5573">drag context used to ask the source about the action that wants to
    perform, so hints are more accurate.</doc>
            <type name="Gdk.DragContext" c:type="GdkDragContext*"/>
          </parameter>
        </parameters>
      </method>
