            <doc xml:space="preserve"
                 filename="gtk/gtktreeviewcolumn.c"
                 line="2140">A #GtkTreeViewColumn.</doc>
            <type name="TreeViewColumn" c:type="GtkTreeViewColumn*"/>
          </instance-parameter>
          <parameter name="fixed_width" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtktreeviewcolumn.c"
                 line="2141">The new fixed width, in pixels, or -1.</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
      </method>
