        <parameters>
          <instance-parameter name="table" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtktable.c"
                 line="653">The #GtkTable to add a new widget to.</doc>
            <type name="Table" c:type="GtkTable*"/>
          </instance-parameter>
          <parameter name="child" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtktable.c"
                 line="654">The widget to add.</doc>
            <type name="Widget" c:type="GtkWidget*"/>
          </parameter>
          <parameter name="left_attach" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtktable.c"
                 line="655">the column number to attach the left side of a child widget to.</doc>
            <type name="guint" c:type="guint"/>
          </parameter>
          <parameter name="right_attach" transfer-ownership="none">
            <doc xml:space="preserve"
