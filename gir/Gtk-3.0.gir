            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtkthemingengine.c"
                 line="534">a #GtkThemingEngine</doc>
            <type name="ThemingEngine" c:type="GtkThemingEngine*"/>
          </instance-parameter>
          <parameter name="state" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtkthemingengine.c"
                 line="535">a widget state</doc>
            <type name="StateType" c:type="GtkStateType"/>
          </parameter>
          <parameter name="progress"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtkthemingengine.c"
                 line="536">return location for the transition progress</doc>
            <type name="gdouble" c:type="gdouble*"/>
          </parameter>
        </parameters>
      </method>
