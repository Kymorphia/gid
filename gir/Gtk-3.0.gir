          <parameter name="rect" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkmenu.c"
                 line="2206">the #GdkRectangle to align @menu with</doc>
            <type name="Gdk.Rectangle" c:type="const GdkRectangle*"/>
          </parameter>
          <parameter name="rect_anchor" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkmenu.c"
                 line="2207">the point on @rect to align with @menu's anchor point</doc>
            <type name="Gdk.Gravity" c:type="GdkGravity"/>
