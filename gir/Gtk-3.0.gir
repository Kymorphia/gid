      <method name="add_credit_section"
              c:identifier="gtk_about_dialog_add_credit_section"
              version="3.4">
        <doc xml:space="preserve"
             filename="gtk/gtkaboutdialog.c"
             line="2546">Creates a new section in the Credits page.</doc>
        <source-position filename="gtk/gtkaboutdialog.h" line="215"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="about" transfer-ownership="none">
