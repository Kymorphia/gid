                 filename="gtk/gtktreeview.c"
                 line="12552">X coordinate of new top-left pixel of visible area, or -1</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
          <parameter name="tree_y" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtktreeview.c"
                 line="12553">Y coordinate of new top-left pixel of visible area, or -1</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
      </method>
