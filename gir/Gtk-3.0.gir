      <field name="get_request_mode">
        <doc xml:space="preserve"
             filename="gtk/gtkwidget.h"
             line="191">This allows a widget to tell its parent container whether
  it prefers to be allocated in %GTK_SIZE_REQUEST_HEIGHT_FOR_WIDTH or
  %GTK_SIZE_REQUEST_WIDTH_FOR_HEIGHT mode.
  %GTK_SIZE_REQUEST_HEIGHT_FOR_WIDTH means the widget prefers to have
  #GtkWidgetClass.get_preferred_width() called and then
  #GtkWidgetClass.get_preferred_height_for_width().
  %GTK_SIZE_REQUEST_CONSTANT_SIZE disables any height-for-width or
  width-for-height geometry management for a said widget and is the
  default return.
  It’s important to note (as described below) that any widget
  which trades height-for-width or width-for-height must respond properly
  to both of the virtual methods #GtkWidgetClass.get_preferred_height_for_width()
  and #GtkWidgetClass.get_preferred_width_for_height() since it might be
  queried in either #GtkSizeRequestMode by its parent container.</doc>
        <callback name="get_request_mode">
          <source-position filename="gtk/gtkwidget.h" line="406"/>
          <return-value transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtksizerequest.c"
                 line="446">The #GtkSizeRequestMode preferred by @widget.</doc>
            <type name="SizeRequestMode" c:type="GtkSizeRequestMode"/>
          </return-value>
          <parameters>
            <parameter name="widget" transfer-ownership="none">
              <doc xml:space="preserve"
                   filename="gtk/gtksizerequest.c"
                   line="436">a #GtkWidget instance</doc>
              <type name="Widget" c:type="GtkWidget*"/>
            </parameter>
          </parameters>
        </callback>
      </field>
