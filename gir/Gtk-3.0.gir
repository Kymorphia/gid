              glib:set-property="expand"
              version="2.4">
        <doc xml:space="preserve"
             filename="gtk/gtktreeviewcolumn.c"
             line="2386">Sets the column to take available extra space.  This space is shared equally
amongst all columns that have the expand set to %TRUE.  If no column has this
option set, then the last column gets all extra space.  By default, every
column is created with this %FALSE.

Along with “fixed-width”, the “expand” property changes when the column is
resized by the user.</doc>
        <source-position filename="gtk/gtktreeviewcolumn.h" line="194"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
