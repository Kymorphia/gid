      <method name="cell_get_size"
              c:identifier="gtk_tree_view_column_cell_get_size">
        <doc xml:space="preserve"
             filename="gtk/gtktreeviewcolumn.c"
             line="2825">Obtains the width and height needed to render the column.  This is used
primarily by the #GtkTreeView.</doc>
