    <class name="FileChooserDialog"
           c:symbol-prefix="file_chooser_dialog"
           c:type="GtkFileChooserDialog"
           parent="Dialog"
           glib:type-name="GtkFileChooserDialog"
           glib:get-type="gtk_file_chooser_dialog_get_type"
