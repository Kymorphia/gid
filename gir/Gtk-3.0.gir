        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk/gtkgestureswipe.c"
               line="296">whether velocity could be calculated</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="gesture" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkgestureswipe.c"
                 line="288">a #GtkGestureSwipe</doc>
            <type name="GestureSwipe" c:type="GtkGestureSwipe*"/>
          </instance-parameter>
          <parameter name="velocity_x"
