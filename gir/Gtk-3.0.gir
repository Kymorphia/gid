      <method name="set_title"
              c:identifier="gtk_window_set_title"
              glib:set-property="title">
        <doc xml:space="preserve"
             filename="gtk/gtkwindow.c"
             line="2401">Sets the title of the #GtkWindow. The title of a window will be
displayed in its title bar; on the X Window System, the title bar
is rendered by the [window manager][gtk-X11-arch],
so exactly how the title appears to users may vary
according to a user’s exact configuration. The title should help a
user distinguish this window from other windows they may have
open. A good title might include the application name and current
document filename, for example.</doc>
        <source-position filename="gtk/gtkwindow.h" line="149"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
