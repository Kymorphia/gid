        </parameter>
        <parameter name="data"
                   transfer-ownership="none"
                   nullable="1"
                   allow-none="1"
                   closure="1">
          <doc xml:space="preserve"
               filename="gtk/gtkassistant.h"
               line="124">user data.</doc>
          <type name="gpointer" c:type="gpointer"/>
