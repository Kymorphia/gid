                 line="17170">The name of the callback as expected in the template XML</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
          <parameter name="callback_symbol"
                     transfer-ownership="none"
                     scope="async">
            <doc xml:space="preserve"
