          <type name="Widget" c:type="GtkWidget*"/>
        </return-value>
        <parameters>
          <parameter name="socket_id" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkplug.c"
                 line="624">the window ID of the socket, or 0.</doc>
            <type name="xlib.Window" c:type="Window"/>
          </parameter>
        </parameters>
      </constructor>
