            <doc xml:space="preserve"
                 filename="gtk/gtktreeview.c"
                 line="1332">the #GtkTreeViewColumn in which the activation occurred</doc>
            <type name="TreeViewColumn"/>
          </parameter>
        </parameters>
      </glib:signal>
