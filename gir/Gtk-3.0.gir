      <method name="to_file"
              c:identifier="gtk_print_settings_to_file"
              version="2.12"
              throws="1">
        <doc xml:space="preserve"
             filename="gtk/gtkprintsettings.c"
             line="1853">This function saves the print settings from @settings to @file_name. If the
file could not be loaded then error is set to either a #GFileError or
#GKeyFileError.</doc>
        <source-position filename="gtk/gtkprintsettings.h" line="70"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk/gtkprintsettings.c"
               line="1863">%TRUE on success</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
