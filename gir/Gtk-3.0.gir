                 line="1115">a #GtkScale</doc>
            <type name="Scale" c:type="GtkScale*"/>
          </instance-parameter>
          <parameter name="digits" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkscale.c"
                 line="1116">the number of decimal places to display,
    e.g. use 1 to display 1.0, 2 to display 1.00, etc</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
      </method>
