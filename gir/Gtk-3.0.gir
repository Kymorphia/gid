        <parameters>
          <parameter name="xalign" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtkalignment.c"
                 line="315">the horizontal alignment of the child widget, from 0 (left) to 1
 (right).</doc>
