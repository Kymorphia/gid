            <doc xml:space="preserve"
                 filename="gtk/gtkimcontextsimple.c"
                 line="1265">A #GtkIMContextSimple</doc>
            <type name="IMContextSimple" c:type="GtkIMContextSimple*"/>
          </instance-parameter>
          <parameter name="compose_file" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkimcontextsimple.c"
                 line="1266">The path of compose file</doc>
