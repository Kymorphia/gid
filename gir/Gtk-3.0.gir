                 line="4716">a #GdkRGBA representing the error color
    of the icon or %NULL to use the default color (allow-none)</doc>
            <type name="Gdk.RGBA" c:type="const GdkRGBA*"/>
          </parameter>
          <parameter name="was_symbolic"
                     direction="out"
