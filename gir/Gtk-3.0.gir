                 filename="gtk/gtktextiter.c"
                 line="2788">an iterator</doc>
            <type name="TextIter" c:type="GtkTextIter*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="backward_visible_lines"
              c:identifier="gtk_text_iter_backward_visible_lines"
              version="2.8">
        <doc xml:space="preserve"
             filename="gtk/gtktextiter.c"
             line="2866">Moves @count visible lines backward, if possible (if @count would move
past the start or end of the buffer, moves to the start or end of
the buffer).  The return value indicates whether the iterator moved
onto a dereferenceable position; if the iterator didn’t move, or
moved onto the end iterator, then %FALSE is returned. If @count is 0,
the function does nothing and returns %FALSE. If @count is negative,
moves forward by 0 - @count lines.</doc>
        <source-position filename="gtk/gtktextiter.h" line="279"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
