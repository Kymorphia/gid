          </parameter>
          <parameter name="within_margin" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtktextview.c"
                 line="2496">margin as a [0.0,0.5) fraction of screen size</doc>
            <type name="gdouble" c:type="gdouble"/>
          </parameter>
          <parameter name="use_align" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtktextview.c"
                 line="2497">whether to use alignment arguments (if %FALSE,
