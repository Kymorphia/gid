            <doc xml:space="preserve"
                 filename="gtk/gtkstylecontext.c"
                 line="2263">a #GtkStyleContext</doc>
            <type name="StyleContext" c:type="GtkStyleContext*"/>
          </instance-parameter>
          <parameter name="window" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkstylecontext.c"
                 line="2264">a #GdkWindow</doc>
