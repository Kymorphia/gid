          </instance-parameter>
          <parameter name="child" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkgrid.c"
                 line="1873">the widget to add</doc>
            <type name="Widget" c:type="GtkWidget*"/>
          </parameter>
          <parameter name="left" transfer-ownership="none">
