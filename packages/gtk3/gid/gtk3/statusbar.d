/// Module for [Statusbar] class
module gid.gtk3.statusbar;

public import gid.core.basictypes;
import gid.atk1.implementor_iface;
import gid.atk1.implementor_iface_mixin;
import gid.core.utils;
import gid.gobject2.dclosure;
import gid.gobject2.gid_builder;
import gid.gobject2.object;
import gid.gtk3.box;
import gid.gtk3.buildable;
import gid.gtk3.buildable_mixin;
import gid.gtk3.c.functions;
import gid.gtk3.c.types;
import gid.gtk3.container;
import gid.gtk3.orientable;
import gid.gtk3.orientable_mixin;
import gid.gtk3.types;

/**
    A #GtkStatusbar is usually placed along the bottom of an application's
    main #GtkWindow. It may provide a regular commentary of the application's
    status (as is usually the case in a web browser, for example), or may be
    used to simply output a message when the status changes, (when an upload
    is complete in an FTP client, for example).
    
    Status bars in GTK+ maintain a stack of messages. The message at
    the top of the each bar’s stack is the one that will currently be displayed.
    
    Any messages added to a statusbar’s stack must specify a
    context id that is used to uniquely identify
    the source of a message. This context id can be generated by
    [gid.gtk4.statusbar.Statusbar.getContextId], given a message and the statusbar that
    it will be added to. Note that messages are stored in a stack, and when
    choosing which message to display, the stack structure is adhered to,
    regardless of the context identifier of a message.
    
    One could say that a statusbar maintains one stack of messages for
    display purposes, but allows multiple message producers to maintain
    sub-stacks of the messages they produced (via context ids).
    
    Status bars are created using [gid.gtk4.statusbar.Statusbar.new_].
    
    Messages are added to the bar’s stack with [gid.gtk4.statusbar.Statusbar.push].
    
    The message at the top of the stack can be removed using
    [gid.gtk4.statusbar.Statusbar.pop]. A message can be removed from anywhere in the
    stack if its message id was recorded at the time it was added. This
    is done using [gid.gtk4.statusbar.Statusbar.remove].
    
    # CSS node
    
    GtkStatusbar has a single CSS node with name statusbar.
*/
class Statusbar : gid.gtk3.box.Box
{

  /** */
  this(void* ptr, Flag!"Take" take) nothrow
  {
    super(ptr, take);
  }

  /** */
  static GType _getGType() nothrow
  {
    import gid.core.loader : gidSymbolNotFound;
    return cast(void function())gtk_statusbar_get_type != &gidSymbolNotFound ? gtk_statusbar_get_type() : cast(GType)0;
  }

  /** */
  override @property GType _gType() nothrow
  {
    return _getGType();
  }

  /** */
  override @property string _gTypeName() nothrow
  {
    return "GtkStatusbar";
  }

  /** Returns `this`, for use in `with` statements. */
  override Statusbar self() nothrow
  {
    return this;
  }

  /**
      Get builder for [gid.gtk3.statusbar.Statusbar]
      Returns: New builder object
  */
  static StatusbarGidBuilder builder() nothrow
  {
    return new StatusbarGidBuilder;
  }

  /**
      Creates a new #GtkStatusbar ready for messages.
      Returns: the new #GtkStatusbar
  */
  this() nothrow
  {
    if (_usesDSubclassGType) // D subclass GType (see gid.gobject2.object.GObjectSubclass)
    {
      this(_newDSubclassGObject(_dSubclassGType), Yes.Take);
    }
    else
    {
      GtkWidget* _cretval;
      _cretval = gtk_statusbar_new();
      this(_cretval, No.Take);
    }
  }

  /** */
  protected void vfuncTextPopped(uint contextId, string text)
  {
    auto _klass = cast(GtkStatusbarClass*)_vfuncClass;
    if (!_klass.textPopped)
      return;

    const(char)* _text = text.toCString!(No.Malloc, No.Nullable);
    _klass.textPopped(cast(GtkStatusbar*)this._cPtr, contextId, _text);
  }

  /** */
  protected void vfuncTextPushed(uint contextId, string text)
  {
    auto _klass = cast(GtkStatusbarClass*)_vfuncClass;
    if (!_klass.textPushed)
      return;

    const(char)* _text = text.toCString!(No.Malloc, No.Nullable);
    _klass.textPushed(cast(GtkStatusbar*)this._cPtr, contextId, _text);
  }

  /**
      Returns a new context identifier, given a description
      of the actual context. Note that the description is
      not shown in the UI.
  
      Params:
        contextDescription = textual description of what context
                                the new message is being used in
      Returns: an integer id
  */
  uint getContextId(string contextDescription) nothrow
  {
    uint _retval;
    const(char)* _contextDescription = contextDescription.toCString!(No.Malloc, No.Nullable);
    _retval = gtk_statusbar_get_context_id(cast(GtkStatusbar*)this._cPtr, _contextDescription);
    return _retval;
  }

  /**
      Retrieves the box containing the label widget.
      Returns: a #GtkBox
  */
  gid.gtk3.box.Box getMessageArea() nothrow
  {
    GtkWidget* _cretval;
    _cretval = gtk_statusbar_get_message_area(cast(GtkStatusbar*)this._cPtr);
    auto _retval = gid.gobject2.object.ObjectWrap._getDObject!(gid.gtk3.box.Box)(cast(GtkWidget*)_cretval, No.Take);
    return _retval;
  }

  /**
      Removes the first message in the #GtkStatusbar’s stack
      with the given context id.
      
      Note that this may not change the displayed message, if
      the message at the top of the stack has a different
      context id.
  
      Params:
        contextId = a context identifier
  */
  void pop(uint contextId) nothrow
  {
    gtk_statusbar_pop(cast(GtkStatusbar*)this._cPtr, contextId);
  }

  /**
      Pushes a new message onto a statusbar’s stack.
  
      Params:
        contextId = the message’s context id, as returned by
                       [gid.gtk4.statusbar.Statusbar.getContextId]
        text = the message to add to the statusbar
      Returns: a message id that can be used with
                 [gid.gtk4.statusbar.Statusbar.remove].
  */
  uint push(uint contextId, string text) nothrow
  {
    uint _retval;
    const(char)* _text = text.toCString!(No.Malloc, No.Nullable);
    _retval = gtk_statusbar_push(cast(GtkStatusbar*)this._cPtr, contextId, _text);
    return _retval;
  }

  alias remove = gid.gtk3.container.Container.remove;

  /**
      Forces the removal of a message from a statusbar’s stack.
      The exact context_id and message_id must be specified.
  
      Params:
        contextId = a context identifier
        messageId = a message identifier, as returned by [gid.gtk4.statusbar.Statusbar.push]
  */
  void remove(uint contextId, uint messageId) nothrow
  {
    gtk_statusbar_remove(cast(GtkStatusbar*)this._cPtr, contextId, messageId);
  }

  /**
      Forces the removal of all messages from a statusbar's
      stack with the exact context_id.
  
      Params:
        contextId = a context identifier
  */
  void removeAll(uint contextId) nothrow
  {
    gtk_statusbar_remove_all(cast(GtkStatusbar*)this._cPtr, contextId);
  }

  /**
      Connect to `TextPopped` signal.
  
      Is emitted whenever a new message is popped off a statusbar's stack.
  
      Params:
        callback = signal callback delegate or function to connect
  
          `void callback(uint contextId, string text, gid.gtk3.statusbar.Statusbar statusbar)`
  
          `contextId` the context id of the relevant message/statusbar (optional)
  
          `text` the message that was just popped (optional)
  
          `statusbar` the instance the signal is connected to (optional)
  
        after = Yes.After to execute callback after default handler, No.After to execute before (default)
      Returns: Signal ID
  */
  gulong connectTextPopped(T)(T callback, Flag!"After" after = No.After) nothrow
  if (isCallable!T
  && is(ReturnType!T == void)
  && (Parameters!T.length < 1 || (ParameterStorageClassTuple!T[0] == ParameterStorageClass.none && is(Parameters!T[0] == uint)))
  && (Parameters!T.length < 2 || (ParameterStorageClassTuple!T[1] == ParameterStorageClass.none && is(Parameters!T[1] == string)))
  && (Parameters!T.length < 3 || (ParameterStorageClassTuple!T[2] == ParameterStorageClass.none && is(Parameters!T[2] : gid.gtk3.statusbar.Statusbar)))
  && Parameters!T.length < 4)
  {
    extern(C) void _cmarshal(GClosure* _closure, GValue* _returnValue, uint _nParams, const(GValue)* _paramVals, void* _invocHint, void* _marshalData) nothrow
    {
      gidAttachThread();
      assert(_nParams == 3, "Unexpected number of signal parameters");
      auto _dClosure = cast(DGClosure!T*)_closure;
      Tuple!(Parameters!T) _paramTuple;

      static if (Parameters!T.length > 0)
        _paramTuple[0] = getVal!(Parameters!T[0])(&_paramVals[1]);

      static if (Parameters!T.length > 1)
        _paramTuple[1] = getVal!(Parameters!T[1])(&_paramVals[2]);

      static if (Parameters!T.length > 2)
        _paramTuple[2] = getVal!(Parameters!T[2])(&_paramVals[0]);

      try
      {
        _dClosure.cb(_paramTuple[]);
      }
      catch (Exception e)
      {
        gidInvokeCallbackExceptionHandler(e, "gid.gtk3.statusbar.Statusbar.textPopped");
      }
    }

    auto closure = new DClosure(callback, &_cmarshal);
    return connectSignalClosure("text-popped", closure, after);
  }

  /**
      Connect to `TextPushed` signal.
  
      Is emitted whenever a new message gets pushed onto a statusbar's stack.
  
      Params:
        callback = signal callback delegate or function to connect
  
          `void callback(uint contextId, string text, gid.gtk3.statusbar.Statusbar statusbar)`
  
          `contextId` the context id of the relevant message/statusbar (optional)
  
          `text` the message that was pushed (optional)
  
          `statusbar` the instance the signal is connected to (optional)
  
        after = Yes.After to execute callback after default handler, No.After to execute before (default)
      Returns: Signal ID
  */
  gulong connectTextPushed(T)(T callback, Flag!"After" after = No.After) nothrow
  if (isCallable!T
  && is(ReturnType!T == void)
  && (Parameters!T.length < 1 || (ParameterStorageClassTuple!T[0] == ParameterStorageClass.none && is(Parameters!T[0] == uint)))
  && (Parameters!T.length < 2 || (ParameterStorageClassTuple!T[1] == ParameterStorageClass.none && is(Parameters!T[1] == string)))
  && (Parameters!T.length < 3 || (ParameterStorageClassTuple!T[2] == ParameterStorageClass.none && is(Parameters!T[2] : gid.gtk3.statusbar.Statusbar)))
  && Parameters!T.length < 4)
  {
    extern(C) void _cmarshal(GClosure* _closure, GValue* _returnValue, uint _nParams, const(GValue)* _paramVals, void* _invocHint, void* _marshalData) nothrow
    {
      gidAttachThread();
      assert(_nParams == 3, "Unexpected number of signal parameters");
      auto _dClosure = cast(DGClosure!T*)_closure;
      Tuple!(Parameters!T) _paramTuple;

      static if (Parameters!T.length > 0)
        _paramTuple[0] = getVal!(Parameters!T[0])(&_paramVals[1]);

      static if (Parameters!T.length > 1)
        _paramTuple[1] = getVal!(Parameters!T[1])(&_paramVals[2]);

      static if (Parameters!T.length > 2)
        _paramTuple[2] = getVal!(Parameters!T[2])(&_paramVals[0]);

      try
      {
        _dClosure.cb(_paramTuple[]);
      }
      catch (Exception e)
      {
        gidInvokeCallbackExceptionHandler(e, "gid.gtk3.statusbar.Statusbar.textPushed");
      }
    }

    auto closure = new DClosure(callback, &_cmarshal);
    return connectSignalClosure("text-pushed", closure, after);
  }

  /**
      Install the C virtual method trampolines of the vfunc methods which a D class overrides, in the class structure of
      its GType (DiG, see gid.gobject2.object.GObjectSubclass). Overrides of ancestor class vfunc methods are also
      installed. Overriding a vfunc method which has no trampoline is a compile error.
      Params:
        T = D class derived from Statusbar
        klass = Class structure of the GType registered for T
  */
  static void _installVfuncs(T)(void* klass) nothrow
  {
    static assert(is(T : gid.gtk3.statusbar.Statusbar), T.stringof ~ " is not derived from gid.gtk3.statusbar.Statusbar");

    gid.gtk3.container.Container._installVfuncs!T(klass);

    static if (!is(__traits(parent, __traits(getOverloads, T, "vfuncTextPopped", true)[0]) == gid.gtk3.statusbar.Statusbar))
      _installVfunc(klass, "text_popped");

    static if (!is(__traits(parent, __traits(getOverloads, T, "vfuncTextPushed", true)[0]) == gid.gtk3.statusbar.Statusbar))
      _installVfunc(klass, "text_pushed");
  }

  private static void _installVfunc(void* klass, string vfunc) nothrow
  {
    auto _klass = cast(GtkStatusbarClass*)klass;

    switch (vfunc)
    {
      case "text_popped":
      {
        static extern(C) void _vfuncTextPoppedTramp(GtkStatusbar* statusbar, uint contextId, const(char)* text) nothrow
        {
          gidAttachThread();
          auto _obj = cast(gid.gtk3.statusbar.Statusbar)gid.gobject2.object.ObjectWrap._vfuncDObject(cast(void*)statusbar);
          if (!_obj)
          {
            auto _klass = cast(GtkStatusbarClass*)gid.gobject2.object.ObjectWrap._vfuncClassOf(cast(void*)statusbar);
            if (_klass.textPopped)
              return (cast(typeof(&_vfuncTextPoppedTramp))_klass.textPopped)(statusbar, contextId, text);
            return;
          }

          string _text = text.fromCString!(No.Free);

          try
          {
            _obj.vfuncTextPopped(contextId, _text);
          }
          catch (Exception e)
          {
            gidInvokeCallbackExceptionHandler(e, "gid.gtk3.statusbar.Statusbar.vfuncTextPopped");
          }
        }

        _klass.textPopped = cast(typeof(_klass.textPopped))&_vfuncTextPoppedTramp;
        break;
      }
      case "text_pushed":
      {
        static extern(C) void _vfuncTextPushedTramp(GtkStatusbar* statusbar, uint contextId, const(char)* text) nothrow
        {
          gidAttachThread();
          auto _obj = cast(gid.gtk3.statusbar.Statusbar)gid.gobject2.object.ObjectWrap._vfuncDObject(cast(void*)statusbar);
          if (!_obj)
          {
            auto _klass = cast(GtkStatusbarClass*)gid.gobject2.object.ObjectWrap._vfuncClassOf(cast(void*)statusbar);
            if (_klass.textPushed)
              return (cast(typeof(&_vfuncTextPushedTramp))_klass.textPushed)(statusbar, contextId, text);
            return;
          }

          string _text = text.fromCString!(No.Free);

          try
          {
            _obj.vfuncTextPushed(contextId, _text);
          }
          catch (Exception e)
          {
            gidInvokeCallbackExceptionHandler(e, "gid.gtk3.statusbar.Statusbar.vfuncTextPushed");
          }
        }

        _klass.textPushed = cast(typeof(_klass.textPushed))&_vfuncTextPushedTramp;
        break;
      }
      default:
      break;
    }
  }
}

/// Fluent builder implementation template for [gid.gtk3.statusbar.Statusbar]
class StatusbarGidBuilderImpl(T) : gid.gtk3.box.BoxGidBuilderImpl!T
{

}

/// Fluent builder for [gid.gtk3.statusbar.Statusbar]
final class StatusbarGidBuilder : StatusbarGidBuilderImpl!StatusbarGidBuilder
{
  /**
      Create object from builder.
      Returns: New object
  */
  Statusbar build() nothrow
  {
    return new Statusbar(cast(void*)createGObject(Statusbar._getGType), Yes.Take);
  }
}
