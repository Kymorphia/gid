/// Module for [GLShaderNode] class
module gid.gsk4.glshader_node;

public import gid.core.basictypes;
import gid.core.utils;
import gid.glib2.bytes;
import gid.gobject2.object;
import gid.graphene1.rect;
import gid.gsk4.c.functions;
import gid.gsk4.c.types;
import gid.gsk4.glshader;
import gid.gsk4.render_node;
import gid.gsk4.types;

/**
    A render node using a GL shader when drawing its children nodes.
*/
@gidGir("GLShaderNode")
class GLShaderNode : gid.gsk4.render_node.RenderNode
{

  /** */
  this(void* ptr, Flag!"Take" take) nothrow
  {
    super(ptr, take);
  }

  /** */
  static GType _getGType() nothrow
  {
    import gid.core.loader : gidSymbolNotFound;
    return cast(void function())gsk_gl_shader_node_get_type != &gidSymbolNotFound ? gsk_gl_shader_node_get_type() : cast(GType)0;
  }

  /** */
  override @property GType _gType() nothrow
  {
    return _getGType();
  }

  /**
      Creates a [gid.gsk4.render_node.RenderNode] that will render the given shader into the
      area given by bounds.
      
      The args is a block of data to use for uniform input, as per types and
      offsets defined by the shader. Normally this is generated by
      [gid.gsk4.glshader.GLShader.formatArgs] or [gid.gsk4.shader_args_builder.ShaderArgsBuilder].
      
      See [gid.gsk4.glshader.GLShader] for details about how the shader should be written.
      
      All the children will be rendered into textures (if they aren't already
      `GskTextureNodes`, which will be used directly). These textures will be
      sent as input to the shader.
      
      If the renderer doesn't support GL shaders, or if there is any problem
      when compiling the shader, then the node will draw pink. You should use
      [gid.gsk4.glshader.GLShader.compile] to ensure the shader will work for the
      renderer before using it.
  
      Params:
        shader = the [gid.gsk4.glshader.GLShader]
        bounds = the rectangle to render the shader into
        args = Arguments for the uniforms
        children = array of child nodes,
            these will be rendered to textures and used as input.
      Returns: A new [gid.gsk4.render_node.RenderNode]
  
      Deprecated: GTK's new Vulkan-focused rendering
          does not support this feature. Use [GtkGLArea](../gtk4/class.GLArea.html)
          for OpenGL rendering.
  */
  this(gid.gsk4.glshader.GLShader shader, gid.graphene1.rect.Rect bounds, gid.glib2.bytes.Bytes args, gid.gsk4.render_node.RenderNode[] children = null) nothrow
  {
    GskRenderNode* _cretval;
    uint _nChildren;
    if (children)
      _nChildren = cast(uint)children.length;

    auto _children_arr = new GskRenderNode*[](children.length);
    auto _children = cast(GskRenderNode**)_children_arr.ptr;
    foreach (i, obj; children) _children[i] = obj ? cast(GskRenderNode*)obj._cPtr(No.Dup) : null;
    _cretval = gsk_gl_shader_node_new(shader ? cast(GskGLShader*)shader._cPtr(No.Dup) : null, bounds ? cast(const(graphene_rect_t)*)bounds._cPtr(No.Dup) : null, args ? cast(GBytes*)args._cPtr(No.Dup) : null, _children, _nChildren);
    this(_cretval, Yes.Take);
  }

  /**
      Gets args for the node.
      Returns: A [gid.glib2.bytes.Bytes] with the uniform arguments
  
      Deprecated: GTK's new Vulkan-focused rendering
          does not support this feature. Use [GtkGLArea](../gtk4/class.GLArea.html)
          for OpenGL rendering.
  */
  gid.glib2.bytes.Bytes getArgs() nothrow
  {
    GBytes* _cretval;
    _cretval = gsk_gl_shader_node_get_args(cast(const(GskRenderNode)*)this._cPtr);
    auto _retval = _cretval ? new gid.glib2.bytes.Bytes(cast(void*)_cretval, No.Take) : null;
    return _retval;
  }

  /**
      Gets one of the children.
  
      Params:
        idx = the position of the child to get
      Returns: the idx'th child of node
  
      Deprecated: GTK's new Vulkan-focused rendering
          does not support this feature. Use [GtkGLArea](../gtk4/class.GLArea.html)
          for OpenGL rendering.
  */
  gid.gsk4.render_node.RenderNode getChild(uint idx) nothrow
  {
    GskRenderNode* _cretval;
    _cretval = gsk_gl_shader_node_get_child(cast(const(GskRenderNode)*)this._cPtr, idx);
    auto _retval = _cretval ? new gid.gsk4.render_node.RenderNode(cast(GskRenderNode*)_cretval, No.Take) : null;
    return _retval;
  }

  /**
      Returns the number of children
      Returns: The number of children
  
      Deprecated: GTK's new Vulkan-focused rendering
          does not support this feature. Use [GtkGLArea](../gtk4/class.GLArea.html)
          for OpenGL rendering.
  */
  uint getNChildren() nothrow
  {
    uint _retval;
    _retval = gsk_gl_shader_node_get_n_children(cast(const(GskRenderNode)*)this._cPtr);
    return _retval;
  }

  /**
      Gets shader code for the node.
      Returns: the [gid.gsk4.glshader.GLShader] shader
  */
  gid.gsk4.glshader.GLShader getShader() nothrow
  {
    GskGLShader* _cretval;
    _cretval = gsk_gl_shader_node_get_shader(cast(const(GskRenderNode)*)this._cPtr);
    auto _retval = gid.gobject2.object.ObjectWrap._getDObject!(gid.gsk4.glshader.GLShader)(cast(GskGLShader*)_cretval, No.Take);
    return _retval;
  }
}
