/// Module for [StrokeNode] class
module gid.gsk4.stroke_node;

public import gid.core.basictypes;
import gid.core.utils;
import gid.gsk4.c.functions;
import gid.gsk4.c.types;
import gid.gsk4.path;
import gid.gsk4.render_node;
import gid.gsk4.stroke;
import gid.gsk4.types;

/**
    A render node that will fill the area determined by stroking the the given
    [gid.gsk4.path.Path] using the [gid.gsk4.stroke.Stroke] attributes.
*/
@gidGir("StrokeNode")
class StrokeNode : gid.gsk4.render_node.RenderNode
{

  /** */
  this(void* ptr, Flag!"Take" take) nothrow
  {
    super(ptr, take);
  }

  /** */
  static GType _getGType() nothrow
  {
    import gid.core.loader : gidSymbolNotFound;
    return cast(void function())gsk_stroke_node_get_type != &gidSymbolNotFound ? gsk_stroke_node_get_type() : cast(GType)0;
  }

  /** */
  override @property GType _gType() nothrow
  {
    return _getGType();
  }

  /**
      Creates a #GskRenderNode that will fill the outline generated by stroking
      the given path using the attributes defined in stroke.
      
      The area is filled with child.
      
      GSK aims to follow the SVG semantics for stroking paths.
      E.g. zero-length contours will get round or square line
      caps drawn, regardless whether they are closed or not.
  
      Params:
        child = The node to stroke the area with
        path = The path describing the area to stroke
        stroke = The stroke attributes to use
      Returns: A new #GskRenderNode
  */
  this(gid.gsk4.render_node.RenderNode child, gid.gsk4.path.Path path, gid.gsk4.stroke.Stroke stroke) nothrow
  {
    GskRenderNode* _cretval;
    _cretval = gsk_stroke_node_new(child ? cast(GskRenderNode*)child._cPtr(No.Dup) : null, path ? cast(GskPath*)path._cPtr(No.Dup) : null, stroke ? cast(const(GskStroke)*)stroke._cPtr(No.Dup) : null);
    this(_cretval, No.Take);
  }

  /**
      Gets the child node that is getting drawn by the given node.
      Returns: The child that is getting drawn
  */
  gid.gsk4.render_node.RenderNode getChild() nothrow
  {
    GskRenderNode* _cretval;
    _cretval = gsk_stroke_node_get_child(cast(const(GskRenderNode)*)this._cPtr);
    auto _retval = _cretval ? new gid.gsk4.render_node.RenderNode(cast(GskRenderNode*)_cretval, No.Take) : null;
    return _retval;
  }

  /**
      Retrieves the path that will be stroked with the contents of
      the node.
      Returns: a #GskPath
  */
  gid.gsk4.path.Path getPath() nothrow
  {
    GskPath* _cretval;
    _cretval = gsk_stroke_node_get_path(cast(const(GskRenderNode)*)this._cPtr);
    auto _retval = _cretval ? new gid.gsk4.path.Path(cast(void*)_cretval, No.Take) : null;
    return _retval;
  }

  /**
      Retrieves the stroke attributes used in this node.
      Returns: a #GskStroke
  */
  gid.gsk4.stroke.Stroke getStroke() nothrow
  {
    const(GskStroke)* _cretval;
    _cretval = gsk_stroke_node_get_stroke(cast(const(GskRenderNode)*)this._cPtr);
    auto _retval = _cretval ? new gid.gsk4.stroke.Stroke(cast(void*)_cretval, No.Take) : null;
    return _retval;
  }
}
